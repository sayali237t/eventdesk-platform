# Server Port
PORT=5000

# MongoDB Connection URI (Atlas or local)
# If omitted, server uses a pre-seeded in-memory store for immediate testing
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventdesk?retryWrites=true&w=majority"

# Optional Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"
